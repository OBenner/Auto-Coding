# Auto Claude Web UI Environment Variables
# Copy this file to .env and set your values

# ============================================
# API CONFIGURATION
# ============================================

# Backend API URL (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# WebSocket URL (default: ws://localhost:8000)
VITE_WS_URL=ws://localhost:8000

# ============================================
# AUTHENTICATION
# ============================================

# JWT secret for token validation (must match backend)
# VITE_JWT_SECRET=your-secret-key-here

# ============================================
# FEATURE FLAGS
# ============================================

# Enable debug logging
# VITE_DEBUG=true

# Enable real-time updates
# VITE_ENABLE_WEBSOCKET=true

# ============================================
# DEVELOPMENT
# ============================================

# Node environment (automatically set by Vite)
# NODE_ENV=development

# ============================================
# SENTRY ERROR REPORTING
# ============================================

# Sentry DSN for error reporting (optional)
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Trace sample rate for performance monitoring (0.0 to 1.0)
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
