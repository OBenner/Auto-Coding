# Web Frontend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL
# For development, this should point to your local backend server
# Example: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL
# For development, this should point to your local backend WebSocket endpoint
# Example: ws://localhost:8000/ws
VITE_WS_URL=ws://localhost:8000/ws

# =============================================================================
# HOW TO USE
# =============================================================================

# Option 1: Create a .env file in this directory (apps/web-frontend/)
#   Copy this file: cp .env.example .env
#   Then update the values above to match your backend configuration
#
# Option 2: The build-and-start scripts will automatically copy this file
#   to .env if it doesn't exist
#
# Note: Vite only exposes environment variables prefixed with VITE_
# These variables are embedded at build time and available in the browser

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Node environment (automatically set by npm scripts)
# NODE_ENV=development
