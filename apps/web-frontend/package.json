{
	"name": "auto-code-web-ui",
	"version": "2.7.5",
	"type": "module",
	"description": "Web UI for Auto-Coding autonomous coding framework",
	"homepage": "https://github.com/OBenner/Auto-Coding",
	"repository": {
		"type": "git",
		"url": "https://github.com/OBenner/Auto-Coding.git"
	},
	"author": {
		"name": "Auto-Coding Team",
		"email": "mrobenner@gmail.com"
