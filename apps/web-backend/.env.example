# Auto Claude Web Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Host and port for the FastAPI server
HOST=127.0.0.1
PORT=8000

# Enable debug mode (auto-reload, detailed errors, API docs)
# WARNING: Set to false in production!
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Development: Allow localhost on common ports
# Production: Set to your actual frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing
# CRITICAL: Generate a secure random key for production!
# Example: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production

# JWT access token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# AUTO CLAUDE BACKEND INTEGRATION
# =============================================================================
# Path to the Auto Claude backend directory
# Default: ../backend (relative to web-backend directory)
# AUTO_CLAUDE_BACKEND_DIR=/path/to/auto-claude/apps/backend

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# WebSocket heartbeat interval (in seconds)
# Keeps connections alive and detects disconnected clients
WS_HEARTBEAT_INTERVAL=30

# =============================================================================
# LOGGING
# =============================================================================
# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# Log to file (optional)
# LOG_FILE=/var/log/auto-claude-web/app.log

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit .env file to version control
# 2. Generate a strong SECRET_KEY for production
# 3. Restrict CORS_ORIGINS to your actual frontend domain(s)
# 4. Use HTTPS in production (configure via reverse proxy like nginx)
# 5. Consider rate limiting for public deployments
# 6. Review and harden authentication before exposing to internet
