# Web Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server host (default: 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Server port (default: 8000)
PORT=8000

# Debug mode - enables auto-reload and detailed error messages
# Set to false in production
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins (comma-separated list)
# For development, include frontend URL
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Secret key for JWT token signing (REQUIRED)
# Generate a secure random string for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# JWT access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket heartbeat interval in seconds
# Helps detect disconnected clients
WS_HEARTBEAT_INTERVAL=30
