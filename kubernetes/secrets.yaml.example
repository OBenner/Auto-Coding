# IMPORTANT: This is an example file. DO NOT commit actual secrets to git!
#
# To use this file:
# 1. Copy this file to secrets.yaml (which should be in .gitignore)
# 2. Replace all placeholder values with your actual secrets
# 3. Encode all values in base64: echo -n "your-value" | base64
# 4. Apply the secrets: kubectl apply -f kubernetes/secrets.yaml
#
# Example base64 encoding:
#   echo -n "my-secret-key" | base64
#   bXktc2VjcmV0LWtleQ==

apiVersion: v1
kind: Secret
metadata:
  name: auto-claude-secrets
  namespace: auto-claude
  labels:
    app: auto-claude
    component: secrets
type: Opaque
data:
  # PostgreSQL credentials (base64 encoded)
  # Default: postgres / postgres
  postgres-user: cG9zdGdyZXM=
  postgres-password: cG9zdGdyZXM=

  # Database URL (base64 encoded)
  # Format: postgresql://USER:PASSWORD@postgres:5432/autoclaude
  # Example: postgresql://postgres:postgres@postgres:5432/autoclaude
  database-url: cG9zdGdyZXNxbDovL3Bvc3RncmVzOnBvc3RncmVzQHBvc3RncmVzOjU0MzIvYXV0b2NsYXVkZQ==

  # Redis password (optional, base64 encoded)
  # Leave empty for no password
  redis-password: ""

  # Secret key for JWT tokens (base64 encoded)
  # Generate with: openssl rand -base64 32
  # REQUIRED: Replace with your own secure key
  secret-key: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=

  # Claude API keys (base64 encoded)
  # At least one is required
  anthropic-api-key: ""
  claude-code-oauth-token: ""

  # OpenAI API key for Graphiti memory (base64 encoded)
  # Required if graphiti-llm-provider is "openai"
  openai-api-key: ""

  # GitHub OAuth credentials (base64 encoded, optional)
  github-client-id: ""
  github-client-secret: ""

  # GitHub personal access token (base64 encoded, optional)
  github-token: ""

  # GitLab OAuth credentials (base64 encoded, optional)
  gitlab-client-id: ""
  gitlab-client-secret: ""

  # Linear API key (base64 encoded, optional)
  linear-api-key: ""

---
# Alternative: Using external secrets management
# Uncomment and configure if using external-secrets operator
#
# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: auto-claude-secrets
#   namespace: auto-claude
# spec:
#   refreshInterval: 1h
#   secretStoreRef:
#     name: aws-secrets-manager  # or azure-key-vault, gcp-secret-manager, etc.
#     kind: SecretStore
#   target:
#     name: auto-claude-secrets
#     creationPolicy: Owner
#   data:
#   - secretKey: postgres-user
#     remoteRef:
#       key: auto-claude/postgres-user
#   - secretKey: postgres-password
#     remoteRef:
#       key: auto-claude/postgres-password
#   - secretKey: database-url
#     remoteRef:
#       key: auto-claude/database-url
#   - secretKey: secret-key
#     remoteRef:
#       key: auto-claude/secret-key
#   # Add more secrets as needed...
